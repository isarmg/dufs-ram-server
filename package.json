{
  "name": "dufs-browser-tests",
  "private": true,
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "build:platform": "node scripts/build-platform.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:types": "tsc -p web/tsconfig.json",
    "test:frontend:unit": "node --test tests/frontend/unit/*.test.mjs",
    "test:frontend": "npm run build:platform && node scripts/build-frontend-candidate.mjs",
    "test:frontend:run": "node scripts/run-frontend-prepared.mjs",
    "test:frontend:headed": "npm run build:platform && node scripts/build-frontend-candidate.mjs --headed",
    "test:frontend:edge": "npm run build:platform && node scripts/build-frontend-candidate.mjs --edge --project=edge",
    "test:frontend:install": "playwright install chromium firefox"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sarmg/admin-web": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-admin-web-0.8.2.tgz",
    "@sarmg/contracts": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-contracts-0.8.2.tgz",
    "@sarmg/http-client": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-http-client-0.8.2.tgz",
    "@sarmg/design-tokens": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-design-tokens-0.8.2.tgz",
    "@sarmg/web-fonts": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-web-fonts-0.8.2.tgz",
    "@sarmg/web-toolchain": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-web-toolchain-0.8.2.tgz",
    "@sarmg/admin-shell": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-admin-shell-0.8.2.tgz",
    "@sarmg/admin-ui": "https://github.com/isarmg/sarmg-foundation-server/releases/download/v0.8.2/sarmg-admin-ui-0.8.2.tgz"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "acorn": "8.17.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
