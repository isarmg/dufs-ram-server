[Unit]
Description=Xczs browser file manager
Documentation=file:/usr/share/doc/xczs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xczs
Group=xczs
UMask=0077
StateDirectory=xczs
StateDirectoryMode=0700
ExecStart=/opt/xczs/bin/xczs run --config /etc/xczs/xczs.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/srv/xczs
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
